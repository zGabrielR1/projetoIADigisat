# Preferencialmente use uma conta MongoDB criada exclusivamente com a role read.
# A senha local é carregada de MONGO_PASSWORD_FILE e nunca deve ir para este arquivo.
MONGO_URI=mongodb://127.0.0.1:12220/?directConnection=true&readPreference=secondaryPreferred
MONGO_DATABASE=DigisatServer
MONGO_USERNAME=root
MONGO_AUTH_SOURCE=admin
MONGO_PASSWORD_FILE=senhamongo.txt
DIGISAT_MODE=live
DIGISAT_BACKUP_DIR=C:\Digisat\SuiteG6\servidor\backup\dados
MAX_REPORT_ROWS=500
INSIGHT_USER=
INSIGHT_PASSWORD=

# Instância isolada do backup restaurado por restore-latest-backup.ps1.
# BACKUP_MONGO_URI=mongodb://127.0.0.1:12231/?directConnection=true&readPreference=secondaryPreferred

# Opcional: servidor compatível com OpenAI, como Ollama com API OpenAI ativada.
# O modelo recebe somente o texto da pergunta e classifica uma operação permitida.
# AI_ENDPOINT=http://127.0.0.1:11434
# AI_MODEL=llama3.1
# AI_API_KEY=
